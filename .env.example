# Names only — never commit values. Copy to .env.local and fill in.

# Public (browser-visible by design; the anon key is the ONLY client-side key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, TEST MODE only (SPEC v3.0, M12). Server-only; read in lib/stripe/server.ts.
# The secret key must start with sk_test_ - the client refuses any other.
STRIPE_SECRET_KEY=
# The webhook endpoint signing secret (stripe listen locally, the dashboard endpoint on a deployment).
STRIPE_WEBHOOK_SECRET=
# The id of the one recurring Pro price in the test-mode dashboard.
STRIPE_PRICE_PRO=
