# dependencies / build
/node_modules/
/.next/
/out/

# generated by Next / TypeScript on every dev run
/next-env.d.ts
/*.tsbuildinfo

# environment — never commit secrets.
# Covers every filename Next.js loads (.env, .env.local, .env.production, ...),
# not just *.local; the committed template is re-included explicitly.
/.env
/.env.*
!/.env.example

# private working files
/WORKLOG.md

# OS / editor junk
.DS_Store

# end-to-end tests (Playwright). Root-anchored.
# /tests/e2e/.auth/ is reserved for captured live sessions if the storageState
# pattern is ever adopted — a stored session is a secret, never commit it.
/tests/e2e/.auth/
/test-results/
/playwright-report/

# vercel CLI link data
/.vercel

# logs
*.log

# Windows junk
Thumbs.db