# Names only — never commit values. Copy to .env.local and fill in.

# Public (browser-visible by design; the anon key is the ONLY client-side key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
